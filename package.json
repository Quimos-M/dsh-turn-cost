{
  "name": "dsh-turn-cost",
  "version": "0.1.0",
  "description": "DSH Web 插件：按 DeepSeek 官方人民币定价（含峰谷分时）显示每轮对话花费与会话累计花费，点开可查看缓存命中输入 / 缓存未命中输入 / 输出的分项金额。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "plugin",
    "cost",
    "pricing",
    "token",
    "billing",
    "web-ui"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "DESIGN.md",
    "THIRD_PARTY_NOTICES.md",
    "会话总花费.png",
    "对话每轮花费.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "bash scripts/build.sh && tsdown",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quimos-M/dsh-turn-cost.git"
  },
  "homepage": "https://github.com/Quimos-M/dsh-turn-cost#readme"
}
